            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">PROGRAM SFC_T1
// =====================================================================
// SFC_T1 (Sequential Function Chart)
// Homing and the automatic sequence (GRAFCET E70 .. S70).
// Called from MAIN every cycle. All variables are in MAIN (MAIN.xxx).
// Every step has one ST action (&lt;step&gt;_Active) that runs while the step is active.
// The motors are switched off in MAIN before this chart is called, so a step
// only has to switch ON what it needs.
// =====================================================================
VAR_INPUT
    SFCReset : BOOL;            // SFC flag: TRUE = chart back to the initial step S0 (STOP / homing timeout)
END_VAR
VAR
END_VAR
</xhtml>
            </InterfaceAsPlainText>
