    </Action>
    <Action Name="S0_Active" Id="{db05b2b9-36ae-44bd-9460-1ed54dc55694}">
      <Implementation>
        <ST><![CDATA[// S0: Manual mode (initial step)
// Jog, teach and the commands are handled in MAIN (ST) while nStep = 0.
nStep := 0;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S10_Active" Id="{ca5b13ea-759d-4d09-b8e4-8ab118d1c2ed}">
      <Implementation>
        <ST><![CDATA[// S10: Homing - arm back (until B10)
nStep := 10;
bHomed := FALSE;
M4_Back := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S11_Active" Id="{c62607e3-8868-427b-b248-93395aed6455}">
      <Implementation>
        <ST><![CDATA[// S11: Homing - X to B1 and Y to B4 at the same time
nStep := 11;
M2_Back := NOT B1;                     // each axis stops at its own switch
M3_Up   := NOT B4;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S12_Active" Id="{e36fd0a5-a6a4-4317-8a2e-0027c6194cab}">
      <Implementation>
        <ST><![CDATA[// S12: Homing - wait 0.5 s (tonSettle in MAIN), then set both positions to 0
nStep := 12;
IF tonSettle.Q THEN
    nPosX := 0;
    nPosY := 0;
    bHomed := TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="S30_Active" Id="{9bf5d6b9-ebb7-42d6-9cfc-2c4142ea0094}">
      <Implementation>
        <ST><![CDATA[// S30: Manual - move X to xPosition[nTeachSlot] (target set in ACT_Manual)
nStep := 30;
bDriveX := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S31_Active" Id="{0ca07883-f877-426d-ae68-2fa3b723dead}">
      <Implementation>
        <ST><![CDATA[// S31: Manual - move Y to yPosition[nTeachSlot] (target set in ACT_Manual)
nStep := 31;
bDriveY := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S70_Active" Id="{5b061748-735d-4698-934c-e9f05587ff12}">
      <Implementation>
        <ST><![CDATA[// S70 = E70 Entry step: wait until the crane is at home (B1 * B10 * B4)
nStep := 70;
bShelfSelected := FALSE;                    // ignore any old shelf selection]]></ST>
      </Implementation>
    </Action>
    <Action Name="S71_Active" Id="{3b3be20c-2eff-4a03-841c-34626c952fdb}">
      <Implementation>
        <ST><![CDATA[// S71: Get PosX and PosY from the arrays according to the operator's choice
// (nStep = 71 shows the 3x3 shelf selection on the HMI)
nStep := 71;
bPosXReached := FALSE;
bPosYReached := FALSE;

IF bShelfSelected THEN
    bShelfSelected := FALSE;
    IF nSelColumn >= 1 AND nSelColumn <= 3 AND nSelRow >= 1 AND nSelRow <= 3 THEN
        nTargetX := xPosition[nSelColumn];
        nTargetY := yPosition[nSelRow];
        bPositionFound := TRUE;
    END_IF
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="S72_X_Active" Id="{7b4aaf8d-9a61-4b64-8036-bb877c50e238}">
      <Implementation>
        <ST><![CDATA[// S72 (X part): X moves to the shelf column (M2_Forward via ACT_Positioning)
nStep := 72;
bPositionFound := FALSE;
bDriveX := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S72_Y_Active" Id="{fdc87d99-279f-42e1-8b3c-76e35b05f436}">
      <Implementation>
        <ST><![CDATA[// S72 (Y part): Y moves to the shelf height (M3_Down via ACT_Positioning)
nStep := 72;
bPositionFound := FALSE;
bDriveY := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S73_Active" Id="{01efb135-4762-432d-922d-d3c074f69d3f}">
      <Implementation>
        <ST><![CDATA[// S73: Arm out under the pallet (until B9)
nStep := 73;
M4_Forward := TRUE;
bInPosition := FALSE;
nTargetY := yPosition[nSelRow] - nLiftOffset;   // prepare the lift (up = smaller Y)
bPosYReached := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S74_Active" Id="{3f97c613-1c40-4bcc-bba0-e8ce90084fbd}">
      <Implementation>
        <ST><![CDATA[// S74: Lift the pallet off the shelf (M3_Up via ACT_Positioning)
nStep := 74;
bDriveY := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S75_Active" Id="{4881aad6-da4c-4776-b8d6-4fe6e53c8c4a}">
      <Implementation>
        <ST><![CDATA[// S75: Y in position (M3 off), waits for X
nStep := 75;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S76_Active" Id="{af8ae2ac-818a-4630-aead-29abc069c19f}">
      <Implementation>
        <ST><![CDATA[// S76: X in position (M2 off), waits for Y
nStep := 76;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S77_Active" Id="{49eaff34-9e03-4b62-8fa9-c4e380bf1b66}">
      <Implementation>
        <ST><![CDATA[// S77: Both axes in position
nStep := 77;
bInPosition := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S78_Active" Id="{81856a5c-716c-4e67-bd58-a7f65373f42c}">
      <Implementation>
        <ST><![CDATA[// S78: Arm back with the pallet (until B10)
nStep := 78;
M4_Back := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S79_Active" Id="{4963e2c2-37b0-4f0e-8ad0-5f8a8071b88f}">
      <Implementation>
        <ST><![CDATA[// S79: Get the delivery position (index 0 = conveyor)
nStep := 79;
nTargetX := xPosition[0];              // DeliveryPosX
nTargetY := yPosition[0];              // DeliveryPosY
bPosXReached := FALSE;
bPosYReached := FALSE;
bPositionFound := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S80_X_Active" Id="{16d70cc9-096c-462d-9f67-bd4a8507504c}">
      <Implementation>
        <ST><![CDATA[// S80/S81 (X part): X moves back to the conveyor (M2_Back via ACT_Positioning)
nStep := 80;
bPositionFound := FALSE;
bDriveX := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S80_Y_Active" Id="{2a446d63-b2e3-48b0-8749-172e9d314fe0}">
      <Implementation>
        <ST><![CDATA[// S80/S81 (Y part): Y moves up or down to the delivery height.
// ACT_Positioning chooses the direction (M3_Up or M3_Down) by itself.
nStep := 80;
bPositionFound := FALSE;
bDriveY := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S82_Active" Id="{78900b6a-0145-4cce-a350-5b665b97bc48}">
      <Implementation>
        <ST><![CDATA[// S82: X in position (M2 off), waits for Y
nStep := 82;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S83_Active" Id="{0f60a96e-a9a4-4b27-9242-0c9243e3ed06}">
      <Implementation>
        <ST><![CDATA[// S83: Y in position (M3 off), waits for X
nStep := 83;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S84_Active" Id="{7e9d8599-64ce-4ce0-a9f7-ad889ab89c21}">
      <Implementation>
        <ST><![CDATA[// S84: Both axes in position
nStep := 84;
bInPosition := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S85_Active" Id="{1ec80128-7686-41d7-a415-e76fb385ec7a}">
      <Implementation>
        <ST><![CDATA[// S85: Arm out over the conveyor (until B9)
nStep := 85;
M4_Forward := TRUE;
bInPosition := FALSE;
nTargetY := yPosition[0] + nLowerOffset;   // prepare lowering (down = larger Y)
bPosYReached := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S86_Active" Id="{de85ab36-e2e7-42c5-8aca-095dbd7144b7}">
      <Implementation>
        <ST><![CDATA[// S86: Lower the pallet onto the conveyor (M3_Down via ACT_Positioning)
nStep := 86;
bDriveY := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S87_Active" Id="{cfdd6ebb-8d19-41ec-b910-387829c11e42}">
      <Implementation>
        <ST><![CDATA[// S87: Arm back (until B10)
nStep := 87;
M4_Back := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="S88_Active" Id="{2da9c5e6-1e27-49bc-9365-72a171c50df1}">
      <Implementation>
        <ST><![CDATA[// S88 = S70 Exit step: home again. Homing returns to S70 because bAuto is still TRUE.
nStep := 88;]]></ST>
      </Implementation>
    </Action>
