<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="MAIN" Id="{2cdf1655-4df9-4e66-bf92-393710bff3bb}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN

VAR
    // ---------------- INPUTS ----------------
    B1  AT %I* : BOOL;  // Nr. 5,  B1: reference switch horizontal axis (TRUE = at home)
    B2  AT %I* : BOOL;  // Nr. 6,  B2: light-barrier inside  (TRUE = free, FALSE = pallet)
    B3  AT %I* : BOOL;  // Nr. 7,  B3: light-barrier outside (TRUE = free, FALSE = pallet)
    B4  AT %I* : BOOL;  // Nr. 8,  B4: reference switch vertical axis, top (TRUE = at home)
    B5  AT %I* : BOOL;  // Nr. 11, B5: encoder horizontal axis impulse 1  (EL1202 Term 2 ch. 1)
    B6  AT %I* : BOOL;  // Nr. 12, B6: encoder horizontal axis impulse 2  (EL1202 Term 2 ch. 2)
    B7  AT %I* : BOOL;  // Nr. 13, B7: encoder vertical axis impulse 1    (EL1202 Term 3 ch. 1)
    B8  AT %I* : BOOL;  // Nr. 14, B8: encoder vertical axis impulse 2    (EL1202 Term 3 ch. 2)
    B9  AT %I* : BOOL;  // Nr. 15, B9: reference switch cantilever front (TRUE = arm out)
    B10 AT %I* : BOOL;  // Nr. 16, B10: reference switch cantilever back (TRUE = arm back)

    // ---------------- OUTPUTS ----------------
    M1_Forward AT %Q* : BOOL;  // Nr. 17, Q1 (M1): motor conveyor belt forward
    M1_Back    AT %Q* : BOOL;  // Nr. 18, Q2 (M1): motor conveyor belt backward (moves pallet towards crane)
    M2_Forward AT %Q* : BOOL;  // Nr. 19, Q3 (M2): motor horizontal towards rack
    M2_Back    AT %Q* : BOOL;  // Nr. 20, Q4 (M2): motor horizontal towards conveyor belt
    M3_Down    AT %Q* : BOOL;  // Nr. 21, Q5 (M3): motor vertical axis downward
    M3_Up      AT %Q* : BOOL;  // Nr. 22, Q6 (M3): motor vertical axis upward
    M4_Forward AT %Q* : BOOL;  // Nr. 23, Q7 (M4): motor cantilever forward (arm out)
    M4_Back    AT %Q* : BOOL;  // Nr. 24, Q8 (M4): motor cantilever backward (arm in)
    
	// PalletWaiting
	PalletWaiting: BOOL;
	// AwaitingUserInput
	AwaitingUserInput: BOOL;
	// UserRequest
	UserRequest: BOOL;
	// PickupDone
	PickupDone: BOOL;
	// DeliveryDone
	DeliveryDone: BOOL;
	// Single count for B5
	B5OneShot: R_TRIG;
	// Single count for B6
	B6OneShot: R_TRIG;
	// B7 single count
	B7OneShot: R_TRIG;
	// B8 single count
	B8OneShot: R_TRIG;
	// Encoder current position
	CurrentPosX: DINT;
	// Encoder Y current position
	CurrentPosY: DINT;
	isHoming : BOOL;
	// Stop bool for pausing
	isStop: BOOL;
	isDriveX : BOOL;
	isDriveY : BOOL;
	isPosXReached : BOOL;
	isPosYReached : BOOL;
	TargetX : DINT;    // can come from xPosition array
	TargetY : DINT;    // can come from yPosition array
	Tolerance : DINT;
	// Manual mode check
	isManualMode: BOOL;
	// Step number
	StepNumber: INT;
	// isTeachSlotValid
	isTeachSlotValid: BOOL;

    // ---------------- Step_30: hent palle ----------------
    // Valgt plads fra HMI (sættes når operatøren trykker på en grøn kasse)
    SelectedColumn : DINT;     // 1-3
    SelectedRow    : DINT;     // 1-3
    // Låst kopi af valget, mens kranen henter (så et nyt tryk på HMI ikke ændrer noget midt i hentningen)
    PickColumn     : DINT;
    PickRow        : DINT;
    // Kommandoer til gaflen (cantilever) - bruges af ArmHandling
    ArmOut         : BOOL;     // TRUE = kør gaflen ud, indtil B9
    ArmIn          : BOOL;     // TRUE = kør gaflen ind, indtil B10
    ConveyorOut    : BOOL;     // TRUE = run the conveyor out until the pallet reaches B3 (outer end of the conveyor)
END_VAR

VAR PERSISTENT
    xPosition    : ARRAY[0..3] OF DINT := [0, 0, 0, 0];
    yPosition    : ARRAY[0..3] OF DINT := [0, 0, 0, 0];      // MUST BE TAUGHT before automatic mode
    LiftOffset  : DINT := 0;      // Counts to lift the pallet off the shelf (Step_30 macro, trin S30_30)
    LowerOffset : DINT := 0;      // Counts to lower the pallet onto the conveyor (Step_30 macro, trin S30_70)
    // Lagerets 9 pladser [kolonne, række]: TRUE = der står en palle på pladsen
    SlotOccupied : ARRAY[1..3, 1..3] OF BOOL;
	// Found storage position
	isStorageFound: BOOL;
	IndexX : INT;
    IndexY : INT;
    SlotX  : INT;
    SlotY  : INT;
	// index
	PosX: INT;
	// index
	PosY: INT;
END_VAR

VAR PERSISTENT
    xPosition    : ARRAY[0..2] OF DINT := [100, 200, 300];
    yPosition    : ARRAY[0..2] OF DINT := [30, 60, 90];      // MUST BE TAUGHT before automatic mode
    LiftOffset  : DINT := 0;      // Counts to lift the pallet off the shelf (SFC step S74)
    LowerOffset : DINT := 0;      // Counts to lower the pallet onto the conveyor (SFC step S86)
	isFull : ARRAY[0..2, 0..2] OF BOOL;  // TRUE = slot taken
	
	//Delete after
	Slot       : ARRAY[0..2, 0..2] OF StorageSlots;
    PickupSlot : StorageSlots;    // pickup position, isFull not used
END_VAR


VAR
    // ---------------- HMI: Service page ----------------
    // Manual drive (jog): TRUE while the arrow button on the HMI is held down
    JogToRack      : BOOL;     // X towards the rack / K3   (M2_Forward)
    JogToConveyor  : BOOL;     // X towards the conveyor    (M2_Back)
    JogUp          : BOOL;     // Y up                      (M3_Up)
    JogDown        : BOOL;     // Y down                    (M3_Down)
    JogArmOut      : BOOL;     // arm (gaffel) out          (M4_Forward)
    JogArmIn       : BOOL;     // arm (gaffel) in           (M4_Back)

    // Login to the service page
    LoginUser          : STRING := 'Administrator';  // user name (already filled in)
    LoginPassword      : STRING;                     // typed on the HMI
    LoginPasswordStars : STRING;                     // the password shown as ***
    LoginMessage       : STRING;                     // text shown under the login box
    LoginRequest       : BOOL;     // set TRUE by the "Log ind" button
    LogoutRequest      : BOOL;     // set TRUE by the "Log ud" / "Home" button
    HomeRequest        : BOOL;     // set TRUE by the "Homing" button
    HomeSettleTimer    : TON;      // waits 0.5 s at the reference switches before the position is set to 0
    isServiceUnlocked  : BOOL;            // TRUE  = logged in
    isServiceLocked    : BOOL := TRUE;    // TRUE  = not logged in (the opposite, used by the HMI)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[//Handles the encoder X and Y positions, for use
EncoderCounter();
EncoderManual();

//Service page on the HMI: login / logout and manual mode
ServiceHandling();

//Sequence: decides where the crane should go
//(paused while the crane is driven by hand or is homing from the service page)
IF NOT isManualMode AND NOT isHoming THEN
    SFC();
END_IF

//Drives the X and Y motors to TargetX / TargetY
EncoderPosition();

//Drives the cantilever (arm) out/in until end switch B9 / B10
ArmHandling();

//Manual drive from the service page - in manual mode this overrides the automatic outputs
ManualHandling();

//Homing from the service page - drives the crane to B1/B4 and sets the position to 0
HomingHandling();

//Conveyor: runs the pallet out to B3 after a delivery
ConveyorHandling();

//Handles stop/homing functionality - called last, so a stop always overrides the motors
StopHandler();
]]></ST>
    </Implementation>
    <Folder Name="EncoderHandling" Id="{ce6b336d-e8c1-412c-b260-daa27745d6ba}" />
    <Folder Name="Service_HMI" Id="{c40e0628-93d5-4ae2-bfdb-2e4b1cbb2612}" />
    <Folder Name="Step_30_Macro" Id="{6e75fdd9-9abd-4b6f-8c07-9183c58f4d67}" />
    <Folder Name="Step_50_Macro" Id="{c7165ef3-335b-4476-9db7-81ff204d7e15}" />
    <Action Name="ArmHandling" Id="{75a5c31c-df88-41c8-bf55-2eda17acd3cd}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// Drives the cantilever (gaflen) out or in.
// The motor stops by itself when the end switch is reached:
//   B9  = TRUE -> arm is all the way out
//   B10 = TRUE -> arm is all the way in

// Arm out: runs while ArmOut is TRUE and the front end switch is not reached
M4_Forward := ArmOut AND NOT B9;

// Arm in: runs while ArmIn is TRUE and the back end switch is not reached
// (AND NOT M4_Forward = interlock, so the motor can never get both directions at once)
M4_Back := ArmIn AND NOT B10 AND NOT M4_Forward;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="EncoderCounter" Id="{3b55be1d-aa3c-45e0-9f05-289b29b98eee}" FolderPath="EncoderHandling\">
      <Implementation>
        <ST><![CDATA[//Encoder horizontal counter
B5OneShot(CLK:=B5);
IF B5OneShot.Q THEN
	IF B6 THEN
		CurrentPosX := CurrentPosX - 1;
	ELSE
		CurrentPosX := CurrentPosX + 1;
	END_IF
END_IF

//Encoder vertical counter
B7OneShot(CLK:=B7);
IF B7OneShot.Q THEN
	IF B8 THEN
		CurrentPosY := CurrentPosY - 1;
	ELSE
		CurrentPosY := CurrentPosY + 1;
	END_IF
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="EncoderManual" Id="{2e20add5-2263-487c-b781-5b95cd867abd}" FolderPath="EncoderHandling\">
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Action>
    <Action Name="EncoderPosition" Id="{321ba040-fa09-404d-b40d-5c04afdaade0}" FolderPath="EncoderHandling\">
      <Implementation>
        <ST><![CDATA[// X-axis (horizontal): drive towards TargetX until we are inside the tolerance
IF isDriveX AND NOT isPosXReached THEN
    M2_Forward := CurrentPosX < TargetX - Tolerance;    // towards rack
    M2_Back := CurrentPosX > TargetX + Tolerance;       // towards conveyor
    isPosXReached := NOT M2_Forward AND NOT M2_Back;
ELSE
    // Not driving (or already there) -> motor always off
    M2_Forward := FALSE;
    M2_Back := FALSE;
END_IF

// Y-axis (vertical): drive towards TargetY until we are inside the tolerance
IF isDriveY AND NOT isPosYReached THEN
    M3_Down := CurrentPosY < TargetY - Tolerance;       // larger Y = further down
    M3_Up := CurrentPosY > TargetY + Tolerance;         // smaller Y = further up
    isPosYReached := NOT M3_Down AND NOT M3_Up;
ELSE
    // Not driving (or already there) -> motor always off
    M3_Down := FALSE;
    M3_Up := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="ManualHandling" Id="{b3bd6225-3e85-4377-978a-7a47096bf371}" FolderPath="Service_HMI\">
      <Implementation>
        <ST><![CDATA[// Manual drive of the crane from the service page on the HMI.
// Only active in manual mode. A motor runs while its arrow button is held down.
// Called after the automatic code in MAIN, so in manual mode these lines decide the motors.

IF isManualMode THEN
    // X-axis (horizontal)
    M2_Forward := JogToRack AND NOT JogToConveyor;       // towards the rack / K3
    M2_Back    := JogToConveyor AND NOT JogToRack;       // towards the conveyor

    // Y-axis (vertical) - up stops by itself at the top reference switch B4
    M3_Up      := JogUp AND NOT JogDown AND NOT B4;
    M3_Down    := JogDown AND NOT JogUp;

    // Arm (gaffel) - stops by itself at the end switches B9 (out) and B10 (in)
    M4_Forward := JogArmOut AND NOT JogArmIn AND NOT B9;
    M4_Back    := JogArmIn AND NOT JogArmOut AND NOT B10;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="HomingHandling" Id="{2b8f7f44-b0fe-4d4e-b4e9-efe072aa32df}" FolderPath="Service_HMI\">
      <Implementation>
        <ST><![CDATA[// Homing: drives the crane to its reference position and sets the position to 0.
// Started by the "Homing" button on the service page (only when logged in),
// or automatically after every delivery (S30_90 sets isHoming := TRUE).
// Order: 1) arm in (B10)  2) X to B1 and Y up to B4 at the same time
//        3) wait 0.5 s (the crane rolls a little after the motor stops)  4) CurrentPosX/Y := 0
// Called after ManualHandling in MAIN, so while homing these lines decide the motors.

// "Homing" button pressed on the HMI
IF HomeRequest THEN
    HomeRequest := FALSE;
    IF isServiceUnlocked THEN
        isHoming := TRUE;
    END_IF
END_IF

IF isHoming THEN
    // Never drive away from the reference position while homing
    M2_Forward := FALSE;
    M3_Down    := FALSE;
    M4_Forward := FALSE;

    // 1) Arm in first, so the crane never drives with the arm out
    M4_Back := NOT B10;

    // 2) When the arm is in: X towards the conveyor until B1, and Y up until B4
    M2_Back := B10 AND NOT B1;
    M3_Up   := B10 AND NOT B4;
END_IF

// 3) All three switches reached -> start a 0.5 s timer, so the crane has stopped completely
HomeSettleTimer(IN := isHoming AND B10 AND B1 AND B4, PT := T#500MS);

// 4) After 0.5 s at the switches -> this is position 0
IF HomeSettleTimer.Q THEN
    CurrentPosX := 0;
    CurrentPosY := 0;
    isHoming := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="ConveyorHandling" Id="{4af025fa-4130-4fea-8286-ec0c86cd40f1}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// Runs the conveyor out with the pallet after a delivery (started in S30_90).
// B3 = light barrier at the outer end of the conveyor: TRUE = free, FALSE = pallet is there

// Motor forward (away from the crane) while the pallet has not reached B3
M1_Forward := ConveyorOut AND B3;

// Pallet has reached B3 -> stop, the operator can take the pallet
IF ConveyorOut AND NOT B3 THEN
    ConveyorOut := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="S30_10_DriveToSlot" Id="{d51c90fc-094d-4cb9-8561-7e16400228c5}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[
// S30_10 (entry): Start the pickup - lock the choice from the HMI and drive to the slot

// Lock the choice, so a new click on the HMI cannot change anything during the pickup
PickColumn := SelectedColumn;
PickRow    := SelectedRow;

// Target = the chosen slot. Y = the taught position (arm UNDER the pallet)
TargetX := xPosition[PickColumn];
TargetY := yPosition[PickRow];

// Start a new move on both axes
isPosXReached := FALSE;
isPosYReached := FALSE;
isDriveX := TRUE;
isDriveY := TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="S30_30_LiftPallet" Id="{dd591dbe-206d-4ff7-b5b8-72ffbb01c731}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// S30_30 (entry): Lift the pallet off the shelf
// The arm is out under the pallet -> drive Y a little bit UP (smaller Y = further up)
ArmOut := FALSE;

TargetY := yPosition[PickRow] - LiftOffset;
isPosYReached := FALSE;     // start a new move on the Y-axis
]]></ST>
      </Implementation>
    </Action>
    <Action Name="S30_50_DriveToConveyor" Id="{a6abc7c6-32d2-4666-9fbc-8600822694e8}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// S30_50 (entry): Drive to the conveyor (index 0) with the pallet on the arm
// Y = a little bit ABOVE the conveyor, so the pallet does not hit it
ArmIn := FALSE;

TargetX := xPosition[0];
TargetY := yPosition[0] - LowerOffset;

// Start a new move on both axes
isPosXReached := FALSE;
isPosYReached := FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="S30_70_LowerPallet" Id="{33d65e96-4851-4169-a5dd-66dcae2f46bf}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// S30_70 (entry): Lower the pallet down onto the conveyor
// The arm is out over the conveyor -> drive Y DOWN to the taught conveyor position
ArmOut := FALSE;

TargetY := yPosition[0];
isPosYReached := FALSE;     // start a new move on the Y-axis
]]></ST>
      </Implementation>
    </Action>
    <Action Name="S30_90_PickupFinished" Id="{d8a36c5e-f834-4644-b1ea-6d46babeb5e2}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// S30_90 (entry): Pickup is finished - the pallet is on the conveyor and the arm is in
ArmIn := FALSE;

// Stop driving the X and Y axes
isDriveX := FALSE;
isDriveY := FALSE;

// The slot in the rack is now empty -> the box on the HMI turns grey
SlotOccupied[PickColumn, PickRow] := FALSE;

// Run the conveyor, so the pallet goes out to the operator (ConveyorHandling stops it at B3)
ConveyorOut := TRUE;

// Home the crane after every delivery, so the encoder position is exact again (HomingHandling).
// MAIN does not call the SFC while isHoming is TRUE, so the SFC waits here until homing is done.
isHoming := TRUE;

// Tell the main SFC that we are done (transition PickupDone -> Step_40)
PickupDone := TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="ServiceHandling" Id="{4b8e4c70-f246-4b2e-985e-384daeca6354}" FolderPath="Service_HMI\">
      <Implementation>
        <ST><![CDATA[// Handles the login on the service page of the HMI.
// User name: Administrator   Password: 1

// The HMI uses isServiceLocked to hide/lock the service controls
isServiceLocked := NOT isServiceUnlocked;

// Show the password as stars (*) on the HMI, so it can not be read
LoginPasswordStars := LEFT('**********', LEN(LoginPassword));

// "Log ind" button pressed on the HMI
IF LoginRequest THEN
    LoginRequest := FALSE;
    IF LoginUser = 'Administrator' AND LoginPassword = 'Q' THEN
        isServiceUnlocked := TRUE;
        LoginMessage := '';
    ELSE
        LoginMessage := 'Wrong username or password';
    END_IF
    LoginPassword := '';    // always clear the typed password
END_IF

// "Log ud" or "Home" button pressed on the HMI
IF LogoutRequest THEN
    LogoutRequest := FALSE;
    isServiceUnlocked := FALSE;
    isManualMode := FALSE;   // leave manual mode when logging out
END_IF

// Manual mode is only allowed while logged in
IF NOT isServiceUnlocked THEN
    isManualMode := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_10_entry" Id="{4d15c122-3dd4-42ca-9435-859cfe4acda6}" FolderPath="Step_50_Macro\Entry\">
      <Implementation>
        <ST><![CDATA[CurrentPosY := TargetY;
CurrentPosX := TargetX;

M2_Forward := TRUE;
M3_Down := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_100_entry" Id="{08570ba8-3298-4e15-bc1e-e5affacc4106}" FolderPath="Step_50_Macro\Entry\">
      <Implementation>
        <ST><![CDATA[M3_Down := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_100_exit" Id="{ccb4bfc8-bd57-42c5-9b23-d629ecceffd6}" FolderPath="Step_50_Macro\Exit\">
      <Implementation>
        <ST><![CDATA[M3_Down := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_110_entry" Id="{20a108b0-0b4d-4f49-bb5c-f54a5598c27c}" FolderPath="Step_50_Macro\Entry\">
      <Implementation>
        <ST><![CDATA[M4_Back := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_110_exit" Id="{c4f87fd8-f023-451b-a6cc-f4ee74982b82}" FolderPath="Step_50_Macro\Exit\">
      <Implementation>
        <ST><![CDATA[M4_Back := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_20_entry" Id="{f946c215-3dce-416e-843f-d2493ff9a88d}" FolderPath="Step_50_Macro\Entry\">
      <Implementation>
        <ST><![CDATA[EncoderPosition();]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_30_entry" Id="{96e68b3e-3b7f-4d0e-917c-00958f4b4dbb}" FolderPath="Step_50_Macro\Entry\">
      <Implementation>
        <ST><![CDATA[M4_Forward := TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_40_entry" Id="{6a04d296-5c37-4d3d-83f2-dd0e24d22467}" FolderPath="Step_50_Macro\Entry\">
      <Implementation>
        <ST><![CDATA[CurrentPosX := TargetX + Tolerance;
M3_Up := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_40_exit" Id="{a5d5364c-16df-4833-8cc9-7b4c9e766c4a}" FolderPath="Step_50_Macro\Exit\">
      <Implementation>
        <ST><![CDATA[M4_Forward := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_50_entry" Id="{d8ebb905-b608-43d6-80ab-b3b73a9b3df3}" FolderPath="Step_50_Macro\Entry\">
      <Implementation>
        <ST><![CDATA[M4_Back := TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_50_exit" Id="{1dc9462e-fe31-48eb-a529-06f187104a68}" FolderPath="Step_50_Macro\Exit\">
      <Implementation>
        <ST><![CDATA[M4_Back := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_60_entry" Id="{dc8b0595-10d3-4191-bf21-cff05c581db3}" FolderPath="Step_50_Macro\Entry\">
      <Implementation>
        <ST><![CDATA[isStorageFound := FALSE;

FOR IndexY := 0 TO 2 DO
    FOR IndexX := 0 TO 2 DO
        IF NOT Slot[IndexX, IndexY].isFull THEN
            SlotX := IndexX;
            SlotY := IndexY;
            isStorageFound := TRUE;
            EXIT; //Exit first inner loop
        END_IF
    END_FOR
	
    IF isStorageFound THEN
		TargetX := SlotX;
		TargetY := SlotY;
        EXIT; //Exit outer loop
    END_IF
END_FOR

]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_80_entry" Id="{d9c61c5d-cb41-4bb1-957a-e48455939e74}" FolderPath="Step_50_Macro\Entry\">
      <Implementation>
        <ST><![CDATA[EncoderPosition();]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_90_entry" Id="{5ad82b7d-9a40-47c7-bf02-4386fe6d284b}" FolderPath="Step_50_Macro\Entry\">
      <Implementation>
        <ST><![CDATA[M4_Forward := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_90_exit" Id="{24f71d94-1352-4ac3-89dc-5ff3a2ebd222}" FolderPath="Step_50_Macro\Exit\">
      <Implementation>
        <ST><![CDATA[M4_Forward := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="SetDeliveryFalse" Id="{0fd79806-fa9a-4bdb-9fa4-f762d7db8d78}">
      <Implementation>
        <ST><![CDATA[//After delivery has been made, reset the variable
DeliveryDone := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="SetPickupFalse" Id="{54e2c14a-52eb-4c81-869d-c2d794e81f32}">
      <Implementation>
        <ST><![CDATA[//After pickup has been made, reset the variable
PickupDone := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="SetUserRequestTrue" Id="{2f676025-769c-4b38-bacf-04df4d5cccb3}">
      <Implementation>
        <ST><![CDATA[// Step_20 (entry): the operator pressed "Select Pallet" on the HMI
// Clear the old request, so the crane waits for a NEW click on a green box in the dialog
AwaitingUserInput := FALSE;
UserRequest := FALSE;]]></ST>
      </Implementation>
    </Action>
