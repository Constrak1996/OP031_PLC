<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="MAIN" Id="{2cdf1655-4df9-4e66-bf92-393710bff3bb}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN

VAR
    // ---------------- Inputs ----------------
    B1  AT %I* : BOOL;  // Home X (TRUE = at home)
    B2  AT %I* : BOOL;  // Light barrier inside (FALSE = pallet)
    B3  AT %I* : BOOL;  // Light barrier outside (FALSE = pallet)
    B4  AT %I* : BOOL;  // Home Y, top (TRUE = at home)
    B5  AT %I* : BOOL;  // Encoder X, pulse
    B6  AT %I* : BOOL;  // Encoder X, direction
    B7  AT %I* : BOOL;  // Encoder Y, pulse
    B8  AT %I* : BOOL;  // Encoder Y, direction
    B9  AT %I* : BOOL;  // Arm out
    B10 AT %I* : BOOL;  // Arm in

    // ---------------- Outputs ----------------
    M1_Forward AT %Q* : BOOL;  // Conveyor out
    M1_Back    AT %Q* : BOOL;  // Conveyor in (towards crane)
    M2_Forward AT %Q* : BOOL;  // Crane towards rack
    M2_Back    AT %Q* : BOOL;  // Crane towards conveyor
    M3_Down    AT %Q* : BOOL;  // Crane down
    M3_Up      AT %Q* : BOOL;  // Crane up
    M4_Forward AT %Q* : BOOL;  // Arm out
    M4_Back    AT %Q* : BOOL;  // Arm in

    // ---------------- SFC flags ----------------
    palletWaiting     : BOOL;   // Step_10 -> Step_50
    awaitingUserInput : BOOL;   // Step_10 -> Step_20
    userRequest       : BOOL;   // Step_20 -> Step_30
    pickupDone        : BOOL;   // Step_30 -> Step_40
    deliveryDone      : BOOL;   // Step_50 -> Step_60

    // ---------------- Encoder and positioning ----------------
    b5OneShot     : R_TRIG;
    b7OneShot     : R_TRIG;
    currentPosX   : DINT;     // Counts, 0 = B1
    currentPosY   : DINT;     // Counts, 0 = B4 (larger = lower)
    isHoming      : BOOL;
    isStop        : BOOL;
    isDriveX      : BOOL;
    isDriveY      : BOOL;
    isPosXReached : BOOL;
    isPosYReached : BOOL;
    targetX       : DINT;
    targetY       : DINT;
    tolerance     : DINT;     // Counts
    isManualMode  : BOOL;

    // ---------------- Step_30: retrieve pallet ----------------
    selectedColumn : DINT;     // Chosen on the HMI (1-3)
    selectedRow    : DINT;
    pickColumn     : DINT;     // Locked copy during the job
    pickRow        : DINT;
    armOut         : BOOL;     // Until B9
    armIn          : BOOL;     // Until B10
    conveyorOut    : BOOL;     // Until B3

    // ---------------- Step_50: store pallet ----------------
    placeColumn     : DINT;    // Free slot from M_50_S_60
    placeRow        : DINT;
    slotX           : INT;
    slotY           : INT;
    isStorageFound  : BOOL;
    storeRequest    : BOOL;    // "Store Pallet" button
    conveyorIn      : BOOL;    // Until B2
    isStorageFull   : BOOL;
    showStorageFull : BOOL;
    hideStorageFull : BOOL := TRUE;
    palletCount     : INT;
    countX          : INT;
    countY          : INT;
    slotEmpty       : ARRAY[1..3, 1..3] OF BOOL;   // NOT slotOccupied, for the HMI
    showSlotEmpty   : BOOL;
    hideSlotEmpty   : BOOL := TRUE;
    slotEmptyTimer  : TON;

    // ---------------- HMI: status ----------------
    isRetrieving : BOOL;
    isStoring    : BOOL;
    statusText   : STRING;

    // ---------------- HMI: progress box ----------------
    retrievePhase   : INT;      // 0 = hidden, 1-5 = running, 6 = delivered
    storePhase      : INT;      // 0 = hidden, 1-4 = running, 5 = stored
    isProgressDone  : BOOL;
    progressTitle   : STRING;
    progressText    : STRING;
    progressPercent : INT;
    progressHide    : ARRAY[1..20] OF BOOL;   // 20 blocks of 5 %
    progressIndex   : INT;
    hideProgress    : BOOL := TRUE;
    hideProgressOk  : BOOL := TRUE;
    deliveredTimer  : TON;
    okCountdown     : INT;      // "OK (5)"

    // ---------------- HMI: I/O test (manual mode only) ----------------
    testM1Forward : BOOL;
    testM1Back    : BOOL;
    testM2Forward : BOOL;
    testM2Back    : BOOL;
    testM3Down    : BOOL;
    testM3Up      : BOOL;
    testM4Forward : BOOL;
    testM4Back    : BOOL;
    ioTestLocked  : BOOL := TRUE;

    // ---------------- Reset ----------------
    resetRequest   : BOOL;
    cancelRequest  : BOOL;     // "Cancel" in Select Pallet
    resetAll       : BOOL;
    homeAfterReset : BOOL;
    sfcInit        : BOOL;     // SFC flag: back to Step_10

    // ---------------- Alarms ----------------
    alarmActive       : ARRAY[1..8] OF BOOL;   // Latched until cleared
    alarmTimer        : ARRAY[1..8] OF TON;    // A7 has no timer
    alarmIndex        : INT;
    alarmCheck        : BOOL;
    isAlarm           : BOOL;
    alarmFirst        : INT;      // 0 = no alarm
    alarmClearRequest : BOOL;
    alarmBannerText   : STRING;
    alarmHelpText     : STRING;
    hideAlarmBanner   : BOOL := TRUE;
    alarmStateText    : ARRAY[1..8] OF STRING(10) := [8('OK')];
    encoderStillX     : BOOL;
    encoderStillY     : BOOL;
    lastPosX          : DINT;
    lastPosY          : DINT;
    conveyorTimeout   : TIME := T#5S;    // A1, A2
    armTimeout        : TIME := T#10S;   // A3
    positionTimeout   : TIME := T#30S;   // A4
    homingTimeout     : TIME := T#40S;   // A6
    alarmName : ARRAY[1..8] OF STRING := [
        'A1  Pallet did not reach B3',
        'A2  Pallet did not reach B2',
        'A3  Arm did not reach end position',
        'A4  Crane did not reach position',
        'A5  Encoder not counting',
        'A6  Homing failed',
        'A7  Conveyor not free',
        'A8  Arm sensor fault'];
    alarmHelp : ARRAY[1..8] OF STRING := [
        'A1: Remove what blocks the conveyor and check B3.',
        'A2: Check the pallet on the conveyor and B2.',
        'A3: Check the arm for blockage and B9 / B10.',
        'A4: Check that nothing blocks the crane.',
        'A5: Check the encoder cables (B5 - B8).',
        'A6: Check B1, B4 and B10.',
        'A7: Remove the pallet from the conveyor.',
        'A8: Check the arm switches B9 and B10.'];

    // ---------------- HMI: run time ----------------
    runSecondTimer : TON;
    runSeconds     : UDINT;
    runHours       : UDINT;
    runMinutes     : UDINT;
    runSecs        : UDINT;
    runTimeText    : STRING;   // h:mm:ss

    // ---------------- Save persistent data ----------------
    persistentSave        : WritePersistentData;
    savePersistentRequest : BOOL;

    // ---------------- HMI autostart ----------------
    hmiStartTimer   : TON;
    hmiStartProcess : NT_StartProcess;
    isHmiStarted    : BOOL;
END_VAR

VAR PERSISTENT
    // Index 0 = conveyor, 1-3 = C1-C3 / R1-R3
    xPosition    : ARRAY[0..3] OF DINT := [35, 756, 1327, 1929];
    yPosition    : ARRAY[0..3] OF DINT := [673, 828, 450, 89];
    liftOffset   : DINT := 0;      // Lift height in counts
    lowerOffset  : DINT := 0;      // Height above the conveyor in counts
    slotOccupied : ARRAY[1..3, 1..3] OF BOOL;   // [column, row]
END_VAR


VAR
    // ---------------- HMI: Service page ----------------
    // Jog: TRUE while the arrow button is held down
    jogToRack      : BOOL;
    jogToConveyor  : BOOL;
    jogUp          : BOOL;
    jogDown        : BOOL;
    jogArmOut      : BOOL;
    jogArmIn       : BOOL;

    // Login to the service page
    loginUser          : STRING := 'Admin';  // user name
    loginPassword      : STRING;
    loginPasswordStars : STRING;
    loginMessage       : STRING;
    loginRequest       : BOOL;
    logoutRequest      : BOOL;
    homeRequest        : BOOL;
    homeSettleTimer    : TON;
    isServiceUnlocked  : BOOL;
    isServiceLocked    : BOOL := TRUE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[EncoderCounter();

ServiceHandling();

ResetHandling();

// Sequence - paused while stopped, alarm, manual mode or homing
IF NOT isStop AND NOT isAlarm AND NOT isManualMode AND NOT isHoming THEN
    SFC();
END_IF

EncoderPosition();

ArmHandling();

// Overrides the automatic outputs in manual mode
ManualHandling();

HomingHandling();

ConveyorHandling();

IoTestHandling();

AlarmHandling();

StatusHandling();

SaveHandling();

HmiStartHandling();

// Called last, so Stop always wins
StopHandler();
]]></ST>
    </Implementation>
    <Folder Name="EncoderHandling" Id="{ce6b336d-e8c1-412c-b260-daa27745d6ba}" />
    <Folder Name="Service_HMI" Id="{c40e0628-93d5-4ae2-bfdb-2e4b1cbb2612}" />
    <Folder Name="Step_30_Macro" Id="{6e75fdd9-9abd-4b6f-8c07-9183c58f4d67}" />
    <Folder Name="Step_50_Macro" Id="{c7165ef3-335b-4476-9db7-81ff204d7e15}" />
    <Action Name="AlarmHandling" Id="{c118ce92-c78e-478d-ba7a-e2d8add4c3c5}" FolderPath="Service_HMI\">
      <Implementation>
        <ST><![CDATA[// Alarms are latched and stop the machine. Only checked in automatic mode.

// ---- Clear alarms (also by Reset) ----
IF alarmClearRequest THEN
    alarmClearRequest := FALSE;
    FOR alarmIndex := 1 TO 8 DO
        alarmActive[alarmIndex] := FALSE;
    END_FOR
END_IF

// ---- Check for faults ----
alarmCheck := NOT isStop AND NOT isManualMode AND NOT isAlarm;

// A1: pallet does not reach B3
alarmTimer[1](IN := alarmCheck AND M1_Forward, PT := conveyorTimeout);

// A2: pallet does not reach B2
alarmTimer[2](IN := alarmCheck AND M1_Back, PT := conveyorTimeout);

// A3: arm does not reach B9 / B10
alarmTimer[3](IN := alarmCheck AND (M4_Forward OR M4_Back), PT := armTimeout);

// A4: crane does not reach its position
alarmTimer[4](IN := alarmCheck AND ((isDriveX AND NOT isPosXReached) OR (isDriveY AND NOT isPosYReached)),
              PT := positionTimeout);

// A5: motor runs, encoder does not count
encoderStillX := (M2_Forward OR M2_Back) AND (currentPosX = lastPosX);
encoderStillY := (M3_Up OR M3_Down) AND (currentPosY = lastPosY);
lastPosX := currentPosX;
lastPosY := currentPosY;
alarmTimer[5](IN := alarmCheck AND (encoderStillX OR encoderStillY), PT := T#1S);

// A6: homing takes too long
alarmTimer[6](IN := alarmCheck AND isHoming, PT := homingTimeout);

// A7: set in S30_50

// A8: B9 and B10 both TRUE
alarmTimer[8](IN := alarmCheck AND B9 AND B10, PT := T#200MS);

FOR alarmIndex := 1 TO 8 DO
    IF alarmTimer[alarmIndex].Q THEN
        alarmActive[alarmIndex] := TRUE;
    END_IF
END_FOR

// ---- HMI texts (first active alarm) ----
isAlarm := FALSE;
alarmFirst := 0;
FOR alarmIndex := 1 TO 8 DO
    IF alarmActive[alarmIndex] THEN
        isAlarm := TRUE;
        alarmStateText[alarmIndex] := 'Active';
        IF alarmFirst = 0 THEN
            alarmFirst := alarmIndex;
        END_IF
    ELSE
        alarmStateText[alarmIndex] := 'OK';
    END_IF
END_FOR

IF alarmFirst > 0 THEN
    alarmBannerText := alarmName[alarmFirst];
    alarmHelpText   := alarmHelp[alarmFirst];
ELSE
    alarmBannerText := '';
    alarmHelpText   := 'No active alarms';
END_IF
hideAlarmBanner := NOT isAlarm;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="ArmHandling" Id="{75a5c31c-df88-41c8-bf55-2eda17acd3cd}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// Arm out until B9, arm in until B10
M4_Forward := armOut AND NOT B9;

M4_Back := armIn AND NOT B10 AND NOT M4_Forward;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="ConveyorHandling" Id="{4af025fa-4130-4fea-8286-ec0c86cd40f1}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// ---- Out to B3 (retrieve) ----
M1_Forward := conveyorOut AND B3;

IF conveyorOut AND NOT B3 THEN
    conveyorOut := FALSE;
END_IF

// ---- Count pallets ----
palletCount := 0;
FOR countY := 1 TO 3 DO
    FOR countX := 1 TO 3 DO
        IF slotOccupied[countX, countY] THEN
            palletCount := palletCount + 1;
        END_IF
        slotEmpty[countX, countY] := NOT slotOccupied[countX, countY];
    END_FOR
END_FOR
isStorageFull := (palletCount = 9);

// ---- "Store Pallet" button ----
IF storeRequest THEN
    storeRequest := FALSE;
    IF isStorageFull THEN
        showStorageFull := TRUE;
    ELSIF (NOT B3 OR NOT B2) AND NOT conveyorOut THEN
        palletWaiting := TRUE;
    END_IF
END_IF

hideStorageFull := NOT showStorageFull;

// ---- In to B2 (store) - waits for the arm to be out (B9) ----
M1_Back := conveyorIn AND B2 AND B9;

IF conveyorIn AND NOT B2 THEN
    conveyorIn := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="EncoderCounter" Id="{3b55be1d-aa3c-45e0-9f05-289b29b98eee}" FolderPath="EncoderHandling\">
      <Implementation>
        <ST><![CDATA[// X: count on B5, direction from B6
b5OneShot(CLK:=B5);
IF b5OneShot.Q THEN
	IF B6 THEN
		currentPosX := currentPosX - 1;
	ELSE
		currentPosX := currentPosX + 1;
	END_IF
END_IF

// Y: count on B7, direction from B8
b7OneShot(CLK:=B7);
IF b7OneShot.Q THEN
	IF B8 THEN
		currentPosY := currentPosY - 1;
	ELSE
		currentPosY := currentPosY + 1;
	END_IF
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="EncoderPosition" Id="{321ba040-fa09-404d-b40d-5c04afdaade0}" FolderPath="EncoderHandling\">
      <Implementation>
        <ST><![CDATA[// X: drive to targetX
IF isDriveX AND NOT isPosXReached THEN
    M2_Forward := currentPosX < targetX - tolerance;
    M2_Back := currentPosX > targetX + tolerance;
    isPosXReached := NOT M2_Forward AND NOT M2_Back;
ELSE
    M2_Forward := FALSE;
    M2_Back := FALSE;
END_IF

// Y: drive to targetY (larger Y = lower)
IF isDriveY AND NOT isPosYReached THEN
    M3_Down := currentPosY < targetY - tolerance;
    M3_Up := currentPosY > targetY + tolerance;
    isPosYReached := NOT M3_Down AND NOT M3_Up;
ELSE
    M3_Down := FALSE;
    M3_Up := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="HmiStartHandling" Id="{cbae027f-85ba-49b2-b46e-75ecc95eb226}" FolderPath="Service_HMI\">
      <Implementation>
        <ST><![CDATA[// Start the HMI 20 s after PLC start, only if it is not already running
hmiStartTimer(IN := NOT isHmiStarted, PT := T#20S);

hmiStartProcess(NETID     := '',
                PATHSTR   := 'C:\Windows\System32\cmd.exe',
                DIRNAME   := 'C:\TwinCAT\3.1\Components\Plc\Tc3PlcHmi',
                COMNDLINE := '/C tasklist | find /I "Tc3PlcHmi.exe" || start "" "C:\TwinCAT\3.1\Components\Plc\Tc3PlcHmi\Tc3PlcHmi.exe"',
                START     := hmiStartTimer.Q,
                TMOUT     := T#5S);

IF hmiStartTimer.Q AND NOT hmiStartProcess.BUSY THEN
    isHmiStarted := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="HomingHandling" Id="{2b8f7f44-b0fe-4d4e-b4e9-efe072aa32df}" FolderPath="Service_HMI\">
      <Implementation>
        <ST><![CDATA[// Arm in, then X to B1 and Y to B4, wait 0.5 s, position := 0

IF isHoming THEN
    M2_Forward := FALSE;
    M3_Down    := FALSE;
    M4_Forward := FALSE;

    M4_Back := NOT B10;

    M2_Back := B10 AND NOT B1;
    M3_Up   := B10 AND NOT B4;
END_IF

// Wait 0.5 s so the crane has stopped
homeSettleTimer(IN := isHoming AND B10 AND B1 AND B4, PT := T#500MS);

IF homeSettleTimer.Q THEN
    currentPosX := 0;
    currentPosY := 0;
    isHoming := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="IoTestHandling" Id="{ad430ea6-6cc7-44cb-8b39-91d85dbcce0a}" FolderPath="Service_HMI\">
      <Implementation>
        <ST><![CDATA[// Hold-to-run output test (manual mode only)

ioTestLocked := NOT isManualMode;

IF isManualMode THEN
    M1_Forward := M1_Forward OR (testM1Forward AND NOT testM1Back);
    M1_Back    := M1_Back    OR (testM1Back AND NOT testM1Forward);

    M2_Forward := M2_Forward OR (testM2Forward AND NOT testM2Back);
    M2_Back    := M2_Back    OR (testM2Back AND NOT testM2Forward);

    // Up stops at B4
    M3_Down    := M3_Down    OR (testM3Down AND NOT testM3Up);
    M3_Up      := M3_Up      OR (testM3Up AND NOT testM3Down AND NOT B4);

    // Arm stops at B9 / B10
    M4_Forward := M4_Forward OR (testM4Forward AND NOT testM4Back AND NOT B9);
    M4_Back    := M4_Back    OR (testM4Back AND NOT testM4Forward AND NOT B10);

    // Never both directions at once
    IF M1_Forward AND M1_Back THEN
        M1_Forward := FALSE;
        M1_Back    := FALSE;
    END_IF
    IF M2_Forward AND M2_Back THEN
        M2_Forward := FALSE;
        M2_Back    := FALSE;
    END_IF
    IF M3_Down AND M3_Up THEN
        M3_Down := FALSE;
        M3_Up   := FALSE;
    END_IF
    IF M4_Forward AND M4_Back THEN
        M4_Forward := FALSE;
        M4_Back    := FALSE;
    END_IF
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_10_entry" Id="{4d15c122-3dd4-42ca-9435-859cfe4acda6}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[// Drive to the conveyor (arm under the pallet)
palletWaiting := FALSE;
isStoring := TRUE;
storePhase    := 1;
retrievePhase := 0;

targetX := xPosition[0];
targetY := yPosition[0];

isPosXReached := FALSE;
isPosYReached := FALSE;
isDriveX := TRUE;
isDriveY := TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_100_entry" Id="{08570ba8-3298-4e15-bc1e-e5affacc4106}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[// Lower the pallet onto the shelf
armOut := FALSE;

targetY := yPosition[placeRow];
isPosYReached := FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_100_exit" Id="{ccb4bfc8-bd57-42c5-9b23-d629ecceffd6}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_110_entry" Id="{20a108b0-0b4d-4f49-bb5c-f54a5598c27c}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[// Arm in (empty)
armOut := FALSE;
armIn  := TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_110_exit" Id="{c4f87fd8-f023-451b-a6cc-f4ee74982b82}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[// Pallet stored - home the crane
armIn := FALSE;

isDriveX := FALSE;
isDriveY := FALSE;

slotOccupied[placeColumn, placeRow] := TRUE;

isHoming := TRUE;

deliveryDone := TRUE;
isStoring := FALSE;
storePhase := 5;
savePersistentRequest := TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_20_entry" Id="{f946c215-3dce-416e-843f-d2493ff9a88d}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[// Wait until the crane is at the conveyor
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_30_entry" Id="{96e68b3e-3b7f-4d0e-917c-00958f4b4dbb}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[// Arm out, then the conveyor runs the pallet in to B2
armIn  := FALSE;
armOut := TRUE;
conveyorIn := TRUE;
storePhase := 2;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_40_entry" Id="{6a04d296-5c37-4d3d-83f2-dd0e24d22467}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[// Lift the pallet off the conveyor
conveyorIn := FALSE;
armOut := FALSE;

targetY := yPosition[0] - liftOffset;
isPosYReached := FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_40_exit" Id="{a5d5364c-16df-4833-8cc9-7b4c9e766c4a}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_50_entry" Id="{d8ebb905-b608-43d6-80ab-b3b73a9b3df3}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[// Arm in with the pallet
armOut := FALSE;
armIn  := TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_50_exit" Id="{1dc9462e-fe31-48eb-a529-06f187104a68}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_60_entry" Id="{dc8b0595-10d3-4191-bf21-cff05c581db3}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[// Find the first free slot (row 1 first)
armIn := FALSE;
isStorageFound := FALSE;

FOR slotY := 1 TO 3 DO
    FOR slotX := 1 TO 3 DO
        IF NOT isStorageFound AND NOT slotOccupied[slotX, slotY] THEN
            placeColumn := slotX;
            placeRow    := slotY;
            isStorageFound := TRUE;
        END_IF
    END_FOR
END_FOR
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_80_entry" Id="{d9c61c5d-cb41-4bb1-957a-e48455939e74}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[// Drive to the free slot, just above the shelf
targetX := xPosition[placeColumn];
targetY := yPosition[placeRow] - liftOffset;
storePhase := 3;

isPosXReached := FALSE;
isPosYReached := FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_90_entry" Id="{5ad82b7d-9a40-47c7-bf02-4386fe6d284b}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[// Arm out over the shelf
armIn  := FALSE;
armOut := TRUE;
storePhase := 4;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="M_50_S_90_exit" Id="{24f71d94-1352-4ac3-89dc-5ff3a2ebd222}" FolderPath="Step_50_Macro\">
      <Implementation>
        <ST><![CDATA[
]]></ST>
      </Implementation>
    </Action>
    <Action Name="ManualHandling" Id="{b3bd6225-3e85-4377-978a-7a47096bf371}" FolderPath="Service_HMI\">
      <Implementation>
        <ST><![CDATA[// Jog buttons on the service page (manual mode only)

IF isManualMode THEN
    M2_Forward := jogToRack AND NOT jogToConveyor;
    M2_Back    := jogToConveyor AND NOT jogToRack;

    // Up stops at B4
    M3_Up      := jogUp AND NOT jogDown AND NOT B4;
    M3_Down    := jogDown AND NOT jogUp;

    // Arm stops at B9 / B10
    M4_Forward := jogArmOut AND NOT jogArmIn AND NOT B9;
    M4_Back    := jogArmIn AND NOT jogArmOut AND NOT B10;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="ResetHandling" Id="{3c8e7fec-d904-4ea3-9281-cf142b1f55e9}">
      <Implementation>
        <ST><![CDATA[// Reset and Homing: clear everything, SFC to Step_10, then homing.
// Positions and slotOccupied are kept.

IF resetRequest THEN
    resetRequest := FALSE;
    resetAll       := TRUE;
    homeAfterReset := TRUE;
END_IF

IF homeRequest THEN
    homeRequest := FALSE;
    IF isServiceUnlocked THEN
        resetAll       := TRUE;
        homeAfterReset := TRUE;
    END_IF
END_IF

IF resetAll THEN
    resetAll := FALSE;

    awaitingUserInput := FALSE;
    userRequest       := FALSE;
    palletWaiting     := FALSE;
    storeRequest      := FALSE;

    pickupDone   := FALSE;
    deliveryDone := FALSE;

    isDriveX       := FALSE;
    isDriveY       := FALSE;
    isPosXReached  := FALSE;
    isPosYReached  := FALSE;
    armOut         := FALSE;
    armIn          := FALSE;
    conveyorOut    := FALSE;
    conveyorIn     := FALSE;
    isHoming       := FALSE;
    isStorageFound := FALSE;
    isRetrieving   := FALSE;
    isStoring      := FALSE;
    retrievePhase  := 0;
    storePhase     := 0;
    alarmClearRequest := TRUE;

    isManualMode := FALSE;
    isStop       := FALSE;

    // SFC back to Step_10
    sfcInit := TRUE;
    SFC();
    sfcInit := FALSE;
END_IF

IF homeAfterReset THEN
    homeAfterReset := FALSE;
    isHoming := TRUE;
END_IF

// Cancel in Select Pallet: SFC back to Step_10 (only when idle)
IF cancelRequest THEN
    cancelRequest := FALSE;
    IF NOT isRetrieving AND NOT isStoring AND NOT isHoming THEN
        awaitingUserInput := FALSE;
        userRequest       := FALSE;
        showSlotEmpty     := FALSE;
        sfcInit := TRUE;
        SFC();
        sfcInit := FALSE;
    END_IF
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="S30_10_DriveToSlot" Id="{d51c90fc-094d-4cb9-8561-7e16400228c5}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// Lock the chosen slot and drive to it (arm under the pallet)
isRetrieving := TRUE;
retrievePhase := 1;
storePhase    := 0;
pickColumn := selectedColumn;
pickRow    := selectedRow;

targetX := xPosition[pickColumn];
targetY := yPosition[pickRow];

isPosXReached := FALSE;
isPosYReached := FALSE;
isDriveX := TRUE;
isDriveY := TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="S30_30_LiftPallet" Id="{dd591dbe-206d-4ff7-b5b8-72ffbb01c731}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// Lift the pallet off the shelf
armOut := FALSE;

targetY := yPosition[pickRow] - liftOffset;
isPosYReached := FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="S30_50_DriveToConveyor" Id="{a6abc7c6-32d2-4666-9fbc-8600822694e8}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// Drive to the conveyor, just above it
armIn := FALSE;
retrievePhase := 3;

// A7: conveyor must be free
IF NOT B2 OR NOT B3 THEN
    alarmActive[7] := TRUE;
END_IF

targetX := xPosition[0];
targetY := yPosition[0] - lowerOffset;

isPosXReached := FALSE;
isPosYReached := FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="S30_70_LowerPallet" Id="{33d65e96-4851-4169-a5dd-66dcae2f46bf}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// Lower the pallet onto the conveyor
armOut := FALSE;

targetY := yPosition[0];
isPosYReached := FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="S30_90_PickupFinished" Id="{d8a36c5e-f834-4644-b1ea-6d46babeb5e2}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// Pallet on the conveyor - run it out and home the crane
armIn := FALSE;

isDriveX := FALSE;
isDriveY := FALSE;

slotOccupied[pickColumn, pickRow] := FALSE;

conveyorOut := TRUE;
retrievePhase := 5;

isHoming := TRUE;

pickupDone := TRUE;
isRetrieving := FALSE;
savePersistentRequest := TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="SaveHandling" Id="{92553b3d-02c9-4e34-8245-c9a67cd2fbe6}" FolderPath="Service_HMI\">
      <Implementation>
        <ST><![CDATA[// Save PERSISTENT data now, so a power cut loses nothing. Port 851 = this PLC.
persistentSave(NETID := '', PORT := 851, START := savePersistentRequest, TMOUT := T#5S);

IF savePersistentRequest AND NOT persistentSave.BUSY THEN
    savePersistentRequest := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="ServiceHandling" Id="{4b8e4c70-f246-4b2e-985e-384daeca6354}" FolderPath="Service_HMI\">
      <Implementation>
        <ST><![CDATA[// Login: Admin / Q

isServiceLocked := NOT isServiceUnlocked;

loginPasswordStars := LEFT('**********', LEN(loginPassword));

IF loginRequest THEN
    loginRequest := FALSE;
    IF loginUser = 'Admin' AND loginPassword = 'Q' THEN
        isServiceUnlocked := TRUE;
        loginMessage := '';
    ELSE
        loginMessage := 'Wrong username or password';
    END_IF
    loginPassword := '';
END_IF

// Log out (also the Home button) - save changed positions
IF logoutRequest THEN
    logoutRequest := FALSE;
    isServiceUnlocked := FALSE;
    isManualMode := FALSE;
    savePersistentRequest := TRUE;
END_IF

IF NOT isServiceUnlocked THEN
    isManualMode := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="SetDeliveryFalse" Id="{0fd79806-fa9a-4bdb-9fa4-f762d7db8d78}">
      <Implementation>
        <ST><![CDATA[// Step_60 (entry)
deliveryDone := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="SetPickupFalse" Id="{54e2c14a-52eb-4c81-869d-c2d794e81f32}">
      <Implementation>
        <ST><![CDATA[// Step_40 (entry)
pickupDone := FALSE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="SetUserRequestTrue" Id="{2f676025-769c-4b38-bacf-04df4d5cccb3}">
      <Implementation>
        <ST><![CDATA[// Step_20 (entry): wait for a new slot choice
awaitingUserInput := FALSE;
userRequest := FALSE;]]></ST>
      </Implementation>
    </Action>
