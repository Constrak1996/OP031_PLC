    <Action Name="StartArmIn" Id="{3c55db02-dfc7-44dc-a99d-e01662b14db2}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// S30_40 + S30_80 (entry): Drive the arm IN
// ArmHandling stops the motor by itself when B10 (arm in) is reached
armOut := FALSE;
armIn  := TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="StartArmOut" Id="{1bdb9f40-5aba-4231-b68e-05509e416127}" FolderPath="Step_30_Macro\">
      <Implementation>
        <ST><![CDATA[// S30_20 + S30_60 (entry): Drive the arm OUT
// ArmHandling stops the motor by itself when B9 (arm out) is reached
armIn  := FALSE;
armOut := TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="StatusHandling" Id="{0c7e9de1-1273-4b4a-be6a-5f88fc155323}" FolderPath="Service_HMI\">
      <Implementation>
        <ST><![CDATA[// Select Pallet dialog: the message "Pallet slot is empty" disappears again after 4 s
slotEmptyTimer(IN := showSlotEmpty, PT := T#4S);
IF slotEmptyTimer.Q THEN
    showSlotEmpty := FALSE;
END_IF
hideSlotEmpty := NOT showSlotEmpty;

// Status text for the Home page on the HMI: what is the machine doing right now?
// The first line that is TRUE decides the text.
IF isAlarm THEN
    statusText := 'Alarm - see Alarm page';
ELSIF isStop THEN
    statusText := 'Stopped - press Start';
ELSIF isManualMode THEN
    statusText := 'Manual mode';
ELSIF isRetrieving THEN
    statusText := 'Retrieving pallet';
ELSIF isStoring THEN
    statusText := 'Storing pallet';
ELSIF isHoming THEN
    statusText := 'Homing';
ELSIF conveyorOut THEN
    statusText := 'Conveyor running';
ELSE
    statusText := 'Ready';
END_IF

// ---- Progress box on the Home page while a pallet is retrieved (Step_30) or stored (Step_50) ----
// retrievePhase (Step_30) is set in S30_10 (1), S30_50 (3), S30_90 (5) and here (2, 4, 6):
//   1 = crane drives out to the slot
//   2 = crane is at the slot: arm out, lift the pallet, arm in
//   3 = crane drives back to the conveyor with the pallet
//   4 = crane is at the conveyor: arm out, lower the pallet, arm in
//   5 = the conveyor runs the pallet out
//   6 = the pallet has reached B3 -> delivered
// storePhase (Step_50) is set in the step actions:
//   1 = M_50_S_10   crane drives to the conveyor
//   2 = M_50_S_30   arm out, conveyor runs the pallet in, lift, arm in
//   3 = M_50_S_80   crane drives to the free slot with the pallet
//   4 = M_50_S_90   arm out, lower the pallet onto the shelf, arm in
//   5 = M_50_S_110 (exit)  the pallet is stored
// 0 = no box
IF retrievePhase = 1 AND isPosXReached AND isPosYReached THEN
    retrievePhase := 2;
END_IF
IF retrievePhase = 3 AND isPosXReached AND isPosYReached THEN
    retrievePhase := 4;
END_IF
IF retrievePhase = 5 AND NOT conveyorOut THEN
    retrievePhase := 6;        // ConveyorHandling stops the conveyor when the pallet is at B3
END_IF

// Title, text and % for each phase
progressTitle   := '';
progressText    := '';
progressPercent := 0;
IF retrievePhase > 0 THEN
    progressTitle := 'Retrieving pallet';
    CASE retrievePhase OF
        1: progressText := 'Moving out to get the pallet';      progressPercent := 15;
        2: progressText := 'Picking up the pallet';             progressPercent := 35;
        3: progressText := 'Pallet picked up - returning';      progressPercent := 55;
        4: progressText := 'Placing pallet on the conveyor';    progressPercent := 75;
        5: progressText := 'Moving pallet out on the conveyor'; progressPercent := 90;
        6: progressText := 'Pallet delivered';                  progressPercent := 100;
    END_CASE
ELSIF storePhase > 0 THEN
    progressTitle := 'Storing pallet';
    CASE storePhase OF
        1: progressText := 'Moving to the conveyor';              progressPercent := 15;
        2: progressText := 'Taking the pallet from the conveyor'; progressPercent := 35;
        3: progressText := 'Moving pallet to the shelf';          progressPercent := 60;
        4: progressText := 'Placing pallet on the shelf';         progressPercent := 85;
        5: progressText := 'Pallet stored';                       progressPercent := 100;
    END_CASE
END_IF

// Finished? ("Pallet delivered" or "Pallet stored")
isProgressDone := (retrievePhase = 6) OR (storePhase = 5);

// If the operator presses Stop during the job, the box says so
IF isStop AND NOT isProgressDone AND (retrievePhase > 0 OR storePhase > 0) THEN
    IF isAlarm THEN
        progressText := 'Alarm - see Alarm page';
    ELSE
        progressText := 'Stopped - press Start';
    END_IF
END_IF

// The bar: 20 blocks of 5 %. Block number i is shown when the progress has reached i * 5 %
FOR progressIndex := 1 TO 20 DO
    progressHide[progressIndex] := progressPercent < progressIndex * 5;
END_FOR

// When finished: closed with the OK button, or by itself after 5 s
deliveredTimer(IN := isProgressDone, PT := T#5S);
okCountdown := 5 - TIME_TO_INT(deliveredTimer.ET) / 1000;   // 5, 4, 3, 2, 1
IF deliveredTimer.Q THEN
    retrievePhase := 0;
    storePhase    := 0;
END_IF

// The HMI uses these to hide the box and the OK button
hideProgress   := (retrievePhase = 0) AND (storePhase = 0);
hideProgressOk := NOT isProgressDone;

// ---- Run time on the Home page: counts the seconds while the machine is not stopped ----
// The timer restarts itself: when Q is TRUE, IN becomes FALSE in the next cycle (= 1 pulse per second)
runSecondTimer(IN := NOT isStop AND NOT runSecondTimer.Q, PT := T#1S);
IF runSecondTimer.Q THEN
    runSeconds := runSeconds + 1;
END_IF

// Split the seconds into hours, minutes and seconds (without MOD)
runHours   := runSeconds / 3600;
runMinutes := runSeconds / 60 - runHours * 60;
runSecs    := runSeconds - (runSeconds / 60) * 60;

// Build the text 'h:mm:ss' - a 0 in front of minutes and seconds below 10
runTimeText := UDINT_TO_STRING(runHours);
IF runMinutes < 10 THEN
    runTimeText := CONCAT(runTimeText, ':0');
ELSE
    runTimeText := CONCAT(runTimeText, ':');
END_IF
runTimeText := CONCAT(runTimeText, UDINT_TO_STRING(runMinutes));
IF runSecs < 10 THEN
    runTimeText := CONCAT(runTimeText, ':0');
ELSE
    runTimeText := CONCAT(runTimeText, ':');
END_IF
runTimeText := CONCAT(runTimeText, UDINT_TO_STRING(runSecs));
]]></ST>
      </Implementation>
    </Action>
    <Action Name="AlarmHandling" Id="{c118ce92-c78e-478d-ba7a-e2d8add4c3c5}" FolderPath="Service_HMI\">
      <Implementation>
        <ST><![CDATA[// Alarms A1-A8 for the Alarm page on the HMI.
// 1) "Clear alarms" (or Reset) clears all alarms.
// 2) In automatic operation a timer runs for each fault. When it runs out, the alarm becomes active.
// 3) An active alarm stays active (latched) until it is cleared.
//    While an alarm is active the machine is stopped (StopHandler sets isStop := TRUE).
// After "Clear alarms": Start = continue where it stopped, Reset = start over (homing).
// If the fault is still there, the alarm comes again.

// ---- 1) "Clear alarms" button on the HMI (Reset also sets alarmClearRequest) ----
IF alarmClearRequest THEN
    alarmClearRequest := FALSE;
    FOR alarmIndex := 1 TO 8 DO
        alarmActive[alarmIndex] := FALSE;
    END_FOR
END_IF

// ---- 2) Look for faults - only in automatic operation, and not while an alarm is already active ----
alarmCheck := NOT isStop AND NOT isManualMode AND NOT isAlarm;

// A1: Retrieving - the conveyor runs the pallet out, but it does not reach B3 in time
alarmTimer[1](IN := alarmCheck AND M1_Forward, PT := conveyorTimeout);

// A2: Storing - the conveyor runs the pallet in, but it does not reach B2 in time
alarmTimer[2](IN := alarmCheck AND M1_Back, PT := conveyorTimeout);

// A3: The arm motor runs, but the arm does not reach B9 (out) or B10 (in) in time
alarmTimer[3](IN := alarmCheck AND (M4_Forward OR M4_Back), PT := armTimeout);

// A4: The crane drives, but does not reach the target position in time
alarmTimer[4](IN := alarmCheck AND ((isDriveX AND NOT isPosXReached) OR (isDriveY AND NOT isPosYReached)),
              PT := positionTimeout);

// A5: A motor runs, but the encoder value does not change for 1 s (no pulses from B5-B8)
encoderStillX := (M2_Forward OR M2_Back) AND (currentPosX = lastPosX);
encoderStillY := (M3_Up OR M3_Down) AND (currentPosY = lastPosY);
lastPosX := currentPosX;
lastPosY := currentPosY;
alarmTimer[5](IN := alarmCheck AND (encoderStillX OR encoderStillY), PT := T#1S);

// A6: Homing takes too long (B1, B4 or B10 is not reached)
alarmTimer[6](IN := alarmCheck AND isHoming, PT := homingTimeout);

// A7: Conveyor not free - checked in S30_50, before the crane brings a new pallet to the conveyor

// A8: B9 (arm out) and B10 (arm in) are TRUE at the same time - not possible, a switch is faulty
alarmTimer[8](IN := alarmCheck AND B9 AND B10, PT := T#200MS);

// A timer has run out -> the alarm becomes active
FOR alarmIndex := 1 TO 8 DO
    IF alarmTimer[alarmIndex].Q THEN
        alarmActive[alarmIndex] := TRUE;
    END_IF
END_FOR

// ---- 3) Texts for the HMI ----
isAlarm := FALSE;
alarmFirst := 0;
FOR alarmIndex := 1 TO 8 DO
    IF alarmActive[alarmIndex] THEN
        isAlarm := TRUE;
        alarmStateText[alarmIndex] := 'Active';
        IF alarmFirst = 0 THEN
            alarmFirst := alarmIndex;     // remember the first active alarm
        END_IF
    ELSE
        alarmStateText[alarmIndex] := 'OK';
    END_IF
END_FOR

// Banner on the Home page and the "what to do" text on the Alarm page show the first active alarm
IF alarmFirst > 0 THEN
    alarmBannerText := alarmName[alarmFirst];
    alarmHelpText   := alarmHelp[alarmFirst];
ELSE
    alarmBannerText := '';
    alarmHelpText   := 'No active alarms';
END_IF
hideAlarmBanner := NOT isAlarm;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="SaveHandling" Id="{92553b3d-02c9-4e34-8245-c9a67cd2fbe6}" FolderPath="Service_HMI\">
      <Implementation>
        <ST><![CDATA[// Saves the PERSISTENT variables (slotOccupied, xPosition, yPosition, liftOffset, lowerOffset).
// TwinCAT normally only saves them when it is stopped properly. If the power is pulled,
// changes since the last save are lost. So we save them ourselves after every change:
//   - after a pallet is retrieved (S30_90) or stored (M_50_S_110)
//   - when leaving the service page (where positions and pallets can be changed)
// PORT 851 = our PLC project (Storage_Main). NETID '' = this PC.
persistentSave(NETID := '', PORT := 851, START := savePersistentRequest, TMOUT := T#5S);

// The request stays TRUE until the saving is finished (BUSY = FALSE again)
IF savePersistentRequest AND NOT persistentSave.BUSY THEN
    savePersistentRequest := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="HmiStartHandling" Id="{cbae027f-85ba-49b2-b46e-75ecc95eb226}" FolderPath="Service_HMI\">
      <Implementation>
        <ST><![CDATA[// Starts the HMI program (TwinCAT PLC HMI) on the panel PC - once after every PLC start.
// 1) Wait 20 s, so Windows has finished logging in (Auto Logon).
// 2) Run a Windows command (cmd.exe) that starts Tc3PlcHmi.exe,
//    but only if it is not running already (tasklist ... | find ... || start ...).
//    So we never get two HMI windows (TwinCAT also starts it after "Activate Configuration").
hmiStartTimer(IN := NOT isHmiStarted, PT := T#20S);

hmiStartProcess(NETID     := '',
                PATHSTR   := 'C:\Windows\System32\cmd.exe',
                DIRNAME   := 'C:\TwinCAT\3.1\Components\Plc\Tc3PlcHmi',
                COMNDLINE := '/C tasklist | find /I "Tc3PlcHmi.exe" || start "" "C:\TwinCAT\3.1\Components\Plc\Tc3PlcHmi\Tc3PlcHmi.exe"',
                START     := hmiStartTimer.Q,
                TMOUT     := T#5S);

// When the command has been sent, we are done (until the PLC is started again)
IF hmiStartTimer.Q AND NOT hmiStartProcess.BUSY THEN
    isHmiStarted := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="StopHandler" Id="{1caf5844-0934-4437-bf7d-8e3af562876a}">
      <Implementation>
        <ST><![CDATA[// Stop button on the HMI (isStop = TRUE):
// ALL motors off, no matter what the automatic or manual code wants.
// The SFC is not called while isStop is TRUE (see MAIN), so the sequence stands still.
// StopHandler is called last in MAIN, so this always wins.

// An active alarm stops the machine. Start does not work until the alarm is cleared.
IF isAlarm THEN
    isStop := TRUE;
END_IF

IF isStop THEN
    M1_Forward := FALSE;   // conveyor
    M1_Back    := FALSE;
    M2_Forward := FALSE;   // X-axis
    M2_Back    := FALSE;
    M3_Up      := FALSE;   // Y-axis
    M3_Down    := FALSE;
    M4_Forward := FALSE;   // arm
    M4_Back    := FALSE;
END_IF

// While homing, the conveyor may not run in (towards the crane)
IF isHoming THEN
    M1_Back := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Action>
