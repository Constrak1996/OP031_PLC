                  <a et="IInputAction">
                    <o t="STSnippetInputAction">
                      <v n="STSnippet">"// Only a green box (pallet on the slot) can be chosen
IF MAIN.slotOccupied[1,1] THEN
    MAIN.selectedColumn := 1;
    MAIN.selectedRow    := 1;
    MAIN.userRequest    := TRUE;
    MAIN.showSlotEmpty  := FALSE;
END_IF"</v>
                    </o>
