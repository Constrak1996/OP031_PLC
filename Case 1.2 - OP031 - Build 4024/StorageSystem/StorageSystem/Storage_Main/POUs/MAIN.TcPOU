  <POU Name="MAIN" Id="{f71031dd-4874-465c-9807-4df494377606}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	B1  AT %I* : BOOL;  // Nr. 5,  B1: reference switch horizontal axis
    B2  AT %I* : BOOL;  // Nr. 6,  B2: light-barrier inside
    B3  AT %I* : BOOL;  // Nr. 7,  B3: light-barrier outside
    B4  AT %I* : BOOL;  // Nr. 8,  B4: reference switch vertical axis
    B5  AT %I* : BOOL;  // Nr. 11, B5: encoder horizontal axis impulse 1
    B6  AT %I* : BOOL;  // Nr. 12, B6: encoder horizontal axis impulse 2
    B7  AT %I* : BOOL;  // Nr. 13, B7: encoder vertical axis impulse 1
    B8  AT %I* : BOOL;  // Nr. 14, B8: encoder vertical axis impulse 2
    B9  AT %I* : BOOL;  // Nr. 15, B9: reference switch cantilever front
    B10 AT %I* : BOOL;  // Nr. 16, B10: reference switch cantilever back
 
    // ---------------- OUTPUTS ----------------
    M1_Forward AT %Q* : BOOL;  // Nr. 17, Q1 (M1): motor conveyor belt forward
    M1_Back    AT %Q* : BOOL;  // Nr. 18, Q2 (M1): motor conveyor belt backward
    M2_Forward AT %Q* : BOOL;  // Nr. 19, Q3 (M2): motor horizontal towards rack
    M2_Back    AT %Q* : BOOL;  // Nr. 20, Q4 (M2): motor horizontal towards conveyor belt
    M3_Down    AT %Q* : BOOL;  // Nr. 21, Q5 (M3): motor vertical axis downward
    M3_Up      AT %Q* : BOOL;  // Nr. 22, Q6 (M3): motor vertical axis upward
    M4_Forward AT %Q* : BOOL;  // Nr. 23, Q7 (M4): motor cantilever forward
    M4_Back    AT %Q* : BOOL;  // Nr. 24, Q8 (M4): motor cantilever backward
END_VAR
]]></Declaration>
